# LLM Backend: deepseek_api | vllm_local
LLM_BACKEND=deepseek_api
DEEPSEEK_API_KEY=YOUR_API_KEY
DEEPSEEK_BASE_URL=https://api.deepseek.com

# Database
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=chuanyu_finance
POSTGRES_USER=chuanyu
POSTGRES_PASSWORD=chuanyu_dev_pwd

# Crawler
CRAWL_INTERVAL_HOURS=24
CRAWL_TRADING_DAY_ONLY=true

# Scheduler
SCHEDULE_TIME=16:00
NEWS_RETENTION_DAYS=30
POLICY_RETENTION_DAYS=365
